MONGO_URI=mongodb://localhost:27017/pokestock
PORT=3000

# Yllapitajan avain: suojaa kortin lisays/muokkaus/poisto ja tarjousten
# hyvaksynta/hylkays. Keksi oma pitka satunnainen merkkijono.
ADMIN_KEY=vaihda-tama-pitkaan-satunnaiseen-merkkijonoon

# Gmail-tili tarjousilmoituksia varten. Kayta App Password -salasanaa,
# et normaalia Gmail-salasanaa (ks. README: "Sahkopostin kayttoonotto").
GMAIL_USER=oma.pokestock@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Mihin osoitteeseen uudet tarjoukset ilmoitetaan. Jos tyhja, kaytetaan
# GMAIL_USERia.
ADMIN_NOTIFY_EMAIL=oma.pokestock@gmail.com
