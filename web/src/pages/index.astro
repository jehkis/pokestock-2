---
import Layout from '../layouts/Layout.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import ListStates from '../components/ListStates.astro';
import TarjousModal from '../components/TarjousModal.astro';
import '../styles/kauppa.css';
---
<Layout title="PokeStock — Kauppa" bodyClass="kauppa">
  <header class="hero">
    <div class="hero-top">
      <div class="logo">Poke<em>Stock</em></div>
      <a class="admin-link" href="/admin">Ylläpito →</a>
    </div>
    <p class="tag">Pokémon-kortit myynnissä. Tee tarjous kortista, myyjä ottaa yhteyttä jos tarjous hyväksytään.</p>
    <div class="stats"><span class="pulse"></span><b id="statCount">–</b> korttia myynnissä</div>
  </header>

  <div class="toolbar">
    <label class="search-wrap">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input class="search" id="searchInput" type="search" placeholder="Hae nimellä tai numerolla…" />
    </label>
    <select class="sort" id="sortSelect" aria-label="Järjestys">
      <option value="arvo-desc">Arvokkain ensin</option>
      <option value="arvo-asc">Edullisin ensin</option>
      <option value="nimi-asc">Nimi A–Ö</option>
    </select>
  </div>

  <CategoryTabs />

  <div class="panel">
    <div class="grid" id="grid" style="display:none;"></div>
    <ListStates />
  </div>

  <footer>Kortit ja hinnat viitteellisiä, lopullinen hinta sovitaan myyjän kanssa. Kuvat: TCGdex.</footer>

  <TarjousModal slot="after" />
</Layout>

<script>
  import { apiRequest } from '../lib/api';
  import { $, showState } from '../lib/dom';
  import { elavoita, tile } from '../lib/kortti';
  import { filterCards, renderTabs } from '../lib/tabs';
  import { setupTarjous } from '../lib/tarjous';
  import type { Card } from '../lib/types';

  let allCards: Card[] = [];
  let activeCategory = 'Kaikki';
  let searchTerm = '';
  let sortValue = 'arvo-desc';
  let searchDebounce: ReturnType<typeof setTimeout> | undefined;

  const grid = $('grid');
  const avaaTarjous = setupTarjous(() => loadCards());

  async function loadCards() {
    showState('loading');
    grid.style.display = 'none';
    try {
      allCards = await apiRequest<Card[]>('/api/cards?myyty=false');
      $('statCount').textContent = String(allCards.length);
      renderAll();
    } catch (err) {
      showState('error', 'Korttien lataus epäonnistui: ' + (err as Error).message);
    }
  }

  function renderAll() {
    renderTabs($('tabs'), allCards, activeCategory, (cat) => { activeCategory = cat; renderAll(); });
    renderGrid();
  }

  function sorted(list: Card[]) {
    const [key, dir] = sortValue.split('-');
    const k = dir === 'asc' ? 1 : -1;
    return list.sort((a, b) => key === 'nimi' ? a.nimi.localeCompare(b.nimi, 'fi') * k : (a.arvo - b.arvo) * k);
  }

  function renderGrid() {
    const list = sorted(filterCards(allCards, activeCategory, searchTerm));
    if (!list.length) {
      grid.style.display = 'none';
      showState('empty');
      return;
    }
    showState('none');
    grid.style.display = 'grid';
    grid.innerHTML = list.map(tile).join('');

    grid.querySelectorAll<HTMLElement>('[data-open-offer]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = allCards.find((c) => c._id === btn.dataset.openOffer);
        if (card) avaaTarjous(card);
      });
    });
    elavoita(grid);
  }

  $('searchInput').addEventListener('input', (e) => {
    searchTerm = (e.target as HTMLInputElement).value;
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(renderGrid, 120);
  });
  $('sortSelect').addEventListener('change', (e) => {
    sortValue = (e.target as HTMLSelectElement).value;
    renderGrid();
  });

  loadCards();
</script>
