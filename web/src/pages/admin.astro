---
import Layout from '../layouts/Layout.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import ListStates from '../components/ListStates.astro';
import Modal from '../components/Modal.astro';
import { KATEGORIAT, KUNNOT } from '../lib/types';
import '../styles/kauppa.css';

const columns = [
  { key: 'nimi', label: 'Kortti' },
  { key: 'kategoria', label: 'Kategoria' },
  { key: 'kunto', label: 'Kunto' },
  { key: 'arvo', label: 'Arvo', num: true },
];
---
<Layout title="PokeStock — Ylläpito" bodyClass="kauppa admin">
  <header class="hero">
    <div class="hero-top">
      <div class="logo">Poke<em>Stock</em><span class="admin-merkki">Ylläpito</span></div>
      <a class="admin-link" href="/">← Kauppaan</a>
    </div>
    <div class="admin-stats">
      <div class="stat-kortti iso"><span class="label">Kokoelman arvo, myymättä</span><b id="totalValue">—</b></div>
      <div class="stat-kortti"><span class="label">Kortteja</span><b id="totalCount">0</b></div>
      <div class="stat-kortti"><span class="label">Myyty</span><b id="soldCount">0</b></div>
    </div>
    <div class="stats conn" id="connStatus"><span class="pulse"></span><span id="connLabel">Yhdistetään rajapintaan…</span></div>
  </header>

  <div class="panel tarjous-panel" id="tarjousPanel" style="display:none;">
    <div class="tarjous-head">
      <strong>Odottavat tarjoukset</strong>
      <span class="chip" id="tarjousCount">0</span>
    </div>
    <div id="tarjousList"></div>
  </div>

  <div class="toolbar">
    <label class="search-wrap">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input class="search" id="searchInput" type="search" placeholder="Hae nimellä tai numerolla…" />
    </label>
    <button class="btn secondary" id="refreshBtn" type="button">↻ Päivitä</button>
    <button class="btn secondary" id="paivitaHinnatBtn" type="button">💲 Päivitä kaikki hinnat</button>
    <button class="btn" id="addBtn" type="button">+ Lisää kortti</button>
  </div>

  <CategoryTabs />

  <div class="panel taulu">
    <table id="cardTable" style="display:none;">
      <thead>
        <tr>
          <th class="kuva-th" title="Klikkaa kuvaa tai raahaa kuva sen päälle">Kuva</th>
          {columns.map((c) => (
            <th class:list={{ num: c.num }} data-sort={c.key}>{c.label} <span class="arrow" data-arrow={c.key}></span></th>
          ))}
          <th></th>
        </tr>
      </thead>
      <tbody id="tbody"></tbody>
    </table>
    <ListStates />
  </div>
  <input type="file" id="kuvaInput" accept="image/*" hidden />

  <Modal slot="after" id="addModal" title="Lisää kortti" sub="Kortti tallentuu suoraan tietokantaan.">
    <form id="addForm">
      <div class="field"><label for="f_nimi">Kortin nimi</label><input id="f_nimi" required placeholder="esim. Charizard VMAX" /></div>
      <div class="field"><label for="f_numero">Numero</label><input id="f_numero" placeholder="esim. 020/189" /></div>
      <div class="field">
        <label for="f_kategoria">Kategoria</label>
        <select id="f_kategoria">{KATEGORIAT.map((k) => <option>{k}</option>)}</select>
      </div>
      <div class="field">
        <label for="f_kunto">Kunto</label>
        <select id="f_kunto">{KUNNOT.map((k) => <option>{k}</option>)}</select>
      </div>
      <div class="field">
        <label for="f_arvo">Arvo (€)</label>
        <div style="display:flex; gap:8px;">
          <input id="f_arvo" type="number" step="0.01" min="0" required placeholder="0.00" style="flex:1;" />
          <button type="button" class="btn secondary" id="hakuBtn" style="white-space:nowrap;">Hae hinta-arvio</button>
        </div>
        <label class="holo-check">
          <input type="checkbox" id="f_holo" /> Holo / reverse holo -kortti (käytä holo-hintaa)
        </label>
        <div class="hint-inline" id="hakuTulos" style="display:none;"></div>
      </div>
      <div class="field">
        <label for="f_kuva">Oma kuva (valinnainen)</label>
        <div class="kuva-valinta">
          <img id="f_kuvaEsikatselu" alt="" hidden />
          <input id="f_kuva" type="file" accept="image/*" />
        </div>
        <div class="hint-inline miss">Kortti rajataan kuvasta automaattisesti, ja sijaintitiedot poistetaan.</div>
      </div>
      <div class="form-error" id="formError"></div>
      <div class="modal-actions">
        <button type="button" class="btn secondary" data-close>Peruuta</button>
        <button type="submit" class="btn" id="submitBtn">Lisää varastoon</button>
      </div>
    </form>
  </Modal>
</Layout>

<style is:global>
  /* Ylläpito kaupan tummalla tyylillä (kauppa.css); tässä vain ylläpidon omat osat */
  .admin-merkki { display: inline-block; vertical-align: middle; margin-left: 12px; font-size: 13px; letter-spacing: 0.12em; color: var(--neon-2); border: 1px solid color-mix(in srgb, var(--neon-2) 60%, transparent); background: color-mix(in srgb, var(--neon-2) 14%, transparent); padding: 4px 10px; border-radius: 999px; text-shadow: none; }
  .admin-stats { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 22px; }
  .stat-kortti { display: flex; flex-direction: column; gap: 4px; background: var(--paper-2); border: 1px solid var(--line); border-radius: 14px; padding: 14px 18px; min-width: 120px; }
  .stat-kortti .label { font-size: 11px; color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.06em; }
  .stat-kortti b { font-family: 'Chakra Petch', sans-serif; font-size: 26px; line-height: 1; font-variant-numeric: tabular-nums; }
  .stat-kortti.iso { background: linear-gradient(160deg, rgba(124,92,255,0.16), rgba(18,21,42,0.9)); }
  .stat-kortti.iso b { font-size: clamp(30px, 5vw, 40px); color: var(--neon); text-shadow: 0 0 24px rgba(255, 203, 5, 0.35); }
  .admin .conn .pulse { background: var(--brick); animation: none; }
  .admin .conn[data-ok="true"] .pulse { background: var(--teal); animation: pulse 2s infinite; }

  .tarjous-panel { margin-top: 22px !important; background: linear-gradient(160deg, rgba(255,203,5,0.10), rgba(18,21,42,0.9)) !important; border: 1px solid color-mix(in srgb, var(--neon) 40%, transparent) !important; border-radius: 16px; overflow: hidden; }
  .tarjous-head { padding: 14px 18px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; }
  .tarjous-head strong { font-family: 'Chakra Petch', sans-serif; font-size: 17px; text-transform: uppercase; letter-spacing: 0.03em; }
  .tarjous-head .chip { background: var(--neon); color: #12100a; border: 0; }
  .tarjous { padding: 12px 18px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .tarjous:last-child { border-bottom: 0; }
  .tarjous .meta { font-size: 12.5px; color: var(--ink-soft); }
  .tarjous .meta b { color: var(--neon); }
  .tarjous .viesti { font-size: 12px; color: var(--ink-soft); margin-top: 4px; }
  .tarjous .actions { white-space: nowrap; }

  .admin .toolbar .btn { white-space: nowrap; }
  .admin .panel.taulu { background: var(--card); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  thead th { text-align: left; font-weight: 600; color: var(--ink-soft); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; padding: 14px 16px; border-bottom: 1px solid var(--line); background: var(--paper-2); cursor: pointer; white-space: nowrap; }
  thead th:hover { color: var(--ink); }
  thead th.num { text-align: right; }
  thead th .arrow { font-size: 10px; margin-left: 3px; color: var(--neon); }
  tbody td { padding: 10px 16px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  tbody tr { transition: background .12s; }
  tbody tr:hover { background: rgba(124, 92, 255, 0.07); }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr.sold { opacity: 0.45; }
  tbody tr.sold .nimi { text-decoration: line-through; }
  .num-cell { font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; color: var(--ink-soft); }
  td.arvo { text-align: right; font-family: 'Chakra Petch', sans-serif; font-weight: 700; font-size: 16px; color: var(--neon); white-space: nowrap; }
  .row-actions { text-align: right; white-space: nowrap; }
  .icon-btn { font-family: inherit; font-size: 12px; font-weight: 600; cursor: pointer; background: transparent; border: 1px solid var(--line); border-radius: 8px; padding: 6px 10px; color: var(--ink-soft); margin-left: 6px; text-decoration: none; transition: border-color .15s, color .15s; }
  .icon-btn:hover { border-color: var(--neon-2); color: var(--ink); }
  .icon-btn.sold-btn[data-sold="true"] { color: var(--brick); border-color: var(--brick); background: color-mix(in srgb, var(--brick) 12%, transparent); }
  .icon-btn.del-btn:hover, .icon-btn.reject { border-color: var(--brick); color: var(--brick); }
  .icon-btn.accept { border-color: var(--teal); color: var(--teal); }

  .kuva-th { width: 64px; cursor: default !important; }
  .kuva-td { width: 64px; padding-top: 8px !important; padding-bottom: 8px !important; }
  .kuva-solu { position: relative; width: 46px; }
  .kuva-btn { display: grid; place-items: center; width: 46px; aspect-ratio: 63 / 88; padding: 0; border: 1px dashed var(--line); border-radius: 5px; background: var(--paper-2); color: var(--ink-soft); font: inherit; font-size: 10px; line-height: 1.2; cursor: pointer; overflow: hidden; transition: border-color .15s, box-shadow .15s, transform .15s; }
  .kuva-btn img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .kuva-btn.oma { border: 1px solid var(--teal); }
  .kuva-btn:hover, .kuva-btn.raahaus { border-color: var(--neon-2); color: var(--ink); box-shadow: 0 0 14px rgba(124, 92, 255, 0.55); transform: scale(1.06); }
  .kuva-btn.ladataan { opacity: .5; cursor: progress; }
  .kuva-poista { position: absolute; top: -7px; right: -7px; width: 19px; height: 19px; border-radius: 50%; border: 1px solid var(--line); background: var(--card); color: var(--ink-soft); font-size: 12px; line-height: 1; padding: 0; cursor: pointer; display: none; }
  .kuva-solu:hover .kuva-poista, .kuva-poista:focus-visible { display: block; }
  .kuva-poista:hover { color: var(--brick); border-color: var(--brick); }

  .kauppa .field select { background: var(--paper); border-color: var(--line); border-radius: 8px; color: var(--ink); }
  .kauppa .field input[type="file"] { padding: 7px; font-size: 12.5px; color: var(--ink-soft); }
  .kauppa .field input[type="file"]::file-selector-button { font: inherit; font-weight: 600; margin-right: 10px; padding: 6px 12px; border: 1px solid var(--line); border-radius: 6px; background: var(--paper-2); color: var(--ink); cursor: pointer; }
  .kuva-valinta { display: flex; align-items: center; gap: 10px; }
  .kuva-valinta img { width: 52px; aspect-ratio: 63 / 88; object-fit: cover; border-radius: 4px; }
  .holo-check { display: flex !important; align-items: center; gap: 6px; font-size: 12px !important; margin-top: 8px; font-weight: 400 !important; }
  .holo-check input { width: auto !important; }
  .hint-inline { font-size: 11.5px; margin-top: 6px; line-height: 1.4; }
  .hint-inline.ok { color: var(--teal); }
  .hint-inline.miss { color: var(--ink-soft); }
  .hint-inline b { color: var(--ink); }

  @media (max-width: 640px) {
    .stat-kortti { flex: 1; min-width: 90px; padding: 12px 14px; }
    .stat-kortti.iso { flex-basis: 100%; }
    thead th:nth-child(3), tbody td:nth-child(3), thead th:nth-child(4), tbody td:nth-child(4) { display: none; }
    tbody td, thead th { padding-left: 10px; padding-right: 10px; }
    .row-actions .icon-btn:first-child { display: none; }
    .kuva-poista { display: block; }
  }
</style>

<script>
  import { ApiError, apiRequest } from '../lib/api';
  import { $, setupModal, showState } from '../lib/dom';
  import { cardmarketUrl, escapeHtml, eur } from '../lib/format';
  import { pieniKuva } from '../lib/kortti';
  import { filterCards, renderTabs } from '../lib/tabs';
  import type { Card, Tarjous } from '../lib/types';

  const API = '/api/cards';
  const KEY_STORAGE = 'pokestock_admin_key';

  let allCards: Card[] = [];
  let activeCategory = 'Kaikki';
  let searchTerm = '';
  let sortKey: keyof Card = 'arvo';
  let sortDir = -1;
  let searchDebounce: ReturnType<typeof setTimeout> | undefined;
  let hakuKuva = ''; // viimeisimmän hinta-arvion kuva, tallennetaan kortin mukana

  const table = $('cardTable');
  const tbody = $('tbody');
  const modal = setupModal('addModal');

  function setConn(ok: boolean, label: string) {
    $('connStatus').setAttribute('data-ok', String(ok));
    $('connLabel').textContent = label;
  }

  function getAdminKey() {
    let key = sessionStorage.getItem(KEY_STORAGE);
    if (!key) {
      key = prompt('Ylläpitäjän avain:') || '';
      if (key) sessionStorage.setItem(KEY_STORAGE, key);
    }
    return key;
  }

  async function adminRequest<T>(path: string, opts: RequestInit = {}) {
    try {
      return await apiRequest<T>(path, opts, { 'x-admin-key': getAdminKey() });
    } catch (err) {
      if (err instanceof ApiError && err.status === 401) {
        sessionStorage.removeItem(KEY_STORAGE);
        throw new Error('Väärä ylläpitäjän avain. Yritä uudelleen (lataa sivu uudelleen).');
      }
      throw err;
    }
  }

  async function loadCards() {
    showState('loading');
    table.style.display = 'none';
    try {
      allCards = await adminRequest<Card[]>(API);
      setConn(true, 'Yhdistetty');
      renderAll();
    } catch (err) {
      setConn(false, 'Ei yhteyttä rajapintaan');
      showState('error', 'Korttien lataus epäonnistui: ' + (err as Error).message + ' — tarkista, että API-palvelin on käynnissä.');
    }
  }

  function renderAll() {
    renderTabs($('tabs'), allCards, activeCategory, (cat) => { activeCategory = cat; renderAll(); });
    renderTable();
    renderStats();
  }

  function getSorted() {
    return filterCards(allCards, activeCategory, searchTerm).sort((a, b) => {
      let av: any = a[sortKey], bv: any = b[sortKey];
      if (typeof av === 'string') { av = av.toLowerCase(); bv = (bv || '').toLowerCase(); }
      if (av < bv) return -1 * sortDir;
      if (av > bv) return 1 * sortDir;
      return 0;
    });
  }

  function renderTable() {
    const list = getSorted();
    if (!list.length) {
      table.style.display = 'none';
      showState('empty');
      return;
    }
    showState('none');
    table.style.display = '';

    document.querySelectorAll('[data-arrow]').forEach((a) => (a.textContent = ''));
    const arrowEl = document.querySelector(`[data-arrow="${sortKey}"]`);
    if (arrowEl) arrowEl.textContent = sortDir === 1 ? '▲' : '▼';

    tbody.innerHTML = list.map((c) => {
      const isSold = !!c.myyty?.tila;
      return `
        <tr class="${isSold ? 'sold' : ''}">
          <td class="kuva-td">${kuvaSolu(c)}</td>
          <td><div class="nimi">${escapeHtml(c.nimi)}</div><div class="num-cell">${escapeHtml(c.numero || '')}</div></td>
          <td data-kat="${escapeHtml(c.kategoria)}"><span class="kat-badge">${escapeHtml(c.kategoria)}</span></td>
          <td>${escapeHtml(c.kunto || '—')}</td>
          <td class="arvo">${eur(c.arvo)}</td>
          <td class="row-actions">
            <a class="icon-btn" href="${cardmarketUrl(c.nimi)}" target="_blank" rel="noopener noreferrer">Cardmarket ↗</a>
            <button class="icon-btn sold-btn" data-sold="${isSold}" data-id="${c._id}">${isSold ? 'Myyty' : 'Merkitse myydyksi'}</button>
            <button class="icon-btn del-btn" data-id="${c._id}">Poista</button>
          </td>
        </tr>`;
    }).join('');

    tbody.querySelectorAll<HTMLButtonElement>('.kuva-btn').forEach((btn) => {
      const id = btn.dataset.id!;
      btn.addEventListener('click', () => {
        kuvaKortille = id;
        kuvaInput.value = '';
        kuvaInput.click();
      });
      btn.addEventListener('dragover', (e) => { e.preventDefault(); btn.classList.add('raahaus'); });
      btn.addEventListener('dragleave', () => btn.classList.remove('raahaus'));
      btn.addEventListener('drop', (e) => {
        e.preventDefault();
        btn.classList.remove('raahaus');
        const tiedosto = e.dataTransfer?.files[0];
        if (tiedosto) lataaKuva(id, tiedosto);
      });
    });

    tbody.querySelectorAll<HTMLButtonElement>('.kuva-poista').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Poistetaanko oma kuva? Kortille jää TCGdexin virallinen kuva, jos sellainen on.')) return;
        btn.disabled = true;
        try {
          paivitaKortti(await adminRequest<Card>(`${API}/${btn.dataset.id}/kuva`, { method: 'DELETE' }));
        } catch (err) {
          alert('Kuvan poisto epäonnistui: ' + (err as Error).message);
          btn.disabled = false;
        }
      });
    });

    tbody.querySelectorAll<HTMLButtonElement>('.sold-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id!;
        const nowSold = btn.dataset.sold === 'true';
        btn.disabled = true;
        try {
          const updated = await adminRequest<Card>(`${API}/${id}/myyty`, { method: 'PATCH', body: JSON.stringify({ tila: !nowSold }) });
          const idx = allCards.findIndex((c) => c._id === id);
          if (idx >= 0) allCards[idx] = updated;
          renderAll();
        } catch (err) {
          alert('Myyntitilan päivitys epäonnistui: ' + (err as Error).message);
          btn.disabled = false;
        }
      });
    });

    tbody.querySelectorAll<HTMLButtonElement>('.del-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id!;
        if (!confirm('Poistetaanko kortti pysyvästi?')) return;
        btn.disabled = true;
        try {
          await adminRequest(`${API}/${id}`, { method: 'DELETE' });
          allCards = allCards.filter((c) => c._id !== id);
          renderAll();
        } catch (err) {
          alert('Poisto epäonnistui: ' + (err as Error).message);
          btn.disabled = false;
        }
      });
    });
  }

  // Oma kuva (vihreä reunus), TCGdexin kuva tai lisäysnappi
  function kuvaSolu(c: Card) {
    const src = pieniKuva(c);
    const otsikko = c.omaKuva ? 'Oma kuva – klikkaa vaihtaaksesi' : 'Lisää oma kuva (klikkaa tai raahaa kuva tähän)';
    return `
      <div class="kuva-solu">
        <button type="button" class="kuva-btn${c.omaKuva ? ' oma' : ''}" data-id="${c._id}" title="${otsikko}" aria-label="${otsikko}: ${escapeHtml(c.nimi)}">
          ${src ? `<img src="${escapeHtml(src)}" alt="" loading="lazy">` : '+ kuva'}
        </button>
        ${c.omaKuva ? `<button type="button" class="kuva-poista" data-id="${c._id}" title="Poista oma kuva" aria-label="Poista oma kuva: ${escapeHtml(c.nimi)}">×</button>` : ''}
      </div>`;
  }

  function paivitaKortti(kortti: Card) {
    const idx = allCards.findIndex((c) => c._id === kortti._id);
    if (idx >= 0) allCards[idx] = kortti;
    renderAll();
  }

  async function lataaKuva(id: string, tiedosto: File) {
    if (!tiedosto.type.startsWith('image/')) { alert('Valitse kuvatiedosto.'); return; }
    const btn = tbody.querySelector<HTMLButtonElement>(`.kuva-btn[data-id="${id}"]`);
    if (btn) { btn.classList.add('ladataan'); btn.disabled = true; }
    const data = new FormData();
    data.append('kuva', tiedosto);
    try {
      const { kortti } = await adminRequest<{ kortti: Card; rajattu: boolean }>(`${API}/${id}/kuva`, { method: 'POST', body: data });
      paivitaKortti(kortti);
    } catch (err) {
      alert('Kuvan lataus epäonnistui: ' + (err as Error).message);
      if (btn) { btn.classList.remove('ladataan'); btn.disabled = false; }
    }
  }

  const kuvaInput = $<HTMLInputElement>('kuvaInput');
  let kuvaKortille = '';
  kuvaInput.addEventListener('change', () => {
    const tiedosto = kuvaInput.files?.[0];
    if (tiedosto && kuvaKortille) lataaKuva(kuvaKortille, tiedosto);
  });

  function renderStats() {
    const unsold = allCards.filter((c) => !c.myyty?.tila);
    const total = unsold.reduce((s, c) => s + c.arvo, 0);
    $('totalValue').textContent = eur(total);
    $('totalCount').textContent = String(allCards.length);
    $('soldCount').textContent = String(allCards.length - unsold.length);
  }

  document.querySelectorAll<HTMLElement>('thead th[data-sort]').forEach((th) => {
    th.addEventListener('click', () => {
      const key = th.dataset.sort as keyof Card;
      if (sortKey === key) sortDir *= -1;
      else { sortKey = key; sortDir = key === 'arvo' ? -1 : 1; }
      renderTable();
    });
  });

  $('searchInput').addEventListener('input', (e) => {
    searchTerm = (e.target as HTMLInputElement).value;
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(renderTable, 120);
  });

  $('refreshBtn').addEventListener('click', loadCards);

  $('paivitaHinnatBtn').addEventListener('click', async () => {
    const btn = $<HTMLButtonElement>('paivitaHinnatBtn');
    if (!confirm(`Haetaan tuore hinta jokaiselle ${allCards.length} kortille TCGdexista. Tama voi kestaa muutaman minuutin. Jatketaanko?`)) return;

    btn.disabled = true;
    btn.textContent = '💲 Päivitetään… (voi kestää muutaman minuutin)';
    try {
      const tulos = await adminRequest<any>(`${API}/paivita-hinnat`, { method: 'POST' });
      await loadCards();
      let viesti = `Hinnat päivitetty: ${tulos.paivitetty}/${allCards.length} korttia.`;
      if (tulos.tarkista?.length) viesti += `\n\nEpäilyttävä hintapudotus, EI päivitetty automaattisesti (${tulos.tarkista.length}):\n` + tulos.tarkista.map((k: any) => `${k.nimi} #${k.numero}: ${eur(k.vanha)} → ${eur(k.uusi)}?`).join('\n');
      if (tulos.ei_loytynyt?.length) viesti += `\n\nEi löytynyt hintaa (${tulos.ei_loytynyt.length}): ` + tulos.ei_loytynyt.map((k: any) => `${k.nimi} #${k.numero}`).join(', ');
      if (tulos.virhe?.length) viesti += `\n\nVirheitä (${tulos.virhe.length}): ` + tulos.virhe.map((k: any) => k.nimi).join(', ');
      alert(viesti);
    } catch (err) {
      alert('Hintojen päivitys epäonnistui: ' + (err as Error).message);
    } finally {
      btn.disabled = false;
      btn.textContent = '💲 Päivitä kaikki hinnat';
    }
  });

  $('addBtn').addEventListener('click', () => {
    $('hakuTulos').style.display = 'none';
    hakuKuva = '';
    naytaEsikatselu();
    modal.open();
  });

  // Lisäyslomakkeen kuvan esikatselu
  const esikatselu = $<HTMLImageElement>('f_kuvaEsikatselu');
  function naytaEsikatselu() {
    const tiedosto = $<HTMLInputElement>('f_kuva').files?.[0];
    if (esikatselu.src) URL.revokeObjectURL(esikatselu.src);
    esikatselu.hidden = !tiedosto;
    if (tiedosto) esikatselu.src = URL.createObjectURL(tiedosto);
    else esikatselu.removeAttribute('src');
  }
  $('f_kuva').addEventListener('change', naytaEsikatselu);

  $('hakuBtn').addEventListener('click', async () => {
    const nimi = $<HTMLInputElement>('f_nimi').value.trim();
    const numero = $<HTMLInputElement>('f_numero').value.trim();
    const holo = $<HTMLInputElement>('f_holo').checked;
    const tulosEl = $('hakuTulos');
    const btn = $<HTMLButtonElement>('hakuBtn');

    const nayta = (luokka: 'ok' | 'miss', html: string) => {
      tulosEl.className = 'hint-inline ' + luokka;
      tulosEl.innerHTML = html;
      tulosEl.style.display = 'block';
    };

    if (!nimi) { nayta('miss', 'Kirjoita ensin kortin nimi.'); return; }

    btn.disabled = true;
    btn.textContent = 'Haetaan…';
    tulosEl.style.display = 'none';

    try {
      const params = new URLSearchParams({ nimi });
      if (numero) params.set('numero', numero);
      if (holo) params.set('holo', 'true');
      const result = await adminRequest<any>(`/api/hinta-haku?${params.toString()}`);

      if (!result.loytyi) {
        const samannimiset = (result.ehdotukset || []).map((e: any) => `${escapeHtml(e.nimi)} #${escapeHtml(e.numero)}`).join(', ');
        nayta('miss', 'Ei löytynyt tällä nimellä ja numerolla — syötä hinta itse.' + (samannimiset ? `<br>Samannimisiä: ${samannimiset}` : ''));
        return;
      }

      const p = result.paras;
      const h = p.hinta;
      hakuKuva = p.kuva || '';
      const kortti = `<b>${escapeHtml(p.nimi)}</b> #${escapeHtml(p.numero)} — ${escapeHtml(p.setti || 'tuntematon setti')}`;

      if (!h || h.arvo === null || h.arvo === undefined) {
        nayta('miss', `Löytyi: ${kortti}, mutta Cardmarketissa ei ole hintaa tälle kortille — syötä hinta itse.`);
        return;
      }

      $<HTMLInputElement>('f_arvo').value = h.arvo;
      const pvm = h.paivitetty ? new Date(h.paivitetty).toLocaleDateString('fi-FI') : '?';
      let teksti = `Löytyi: ${kortti}<br>Cardmarket (${h.variantti === 'holo' ? 'holo' : 'normaali'}, trendi): <b>${eur(h.arvo)}</b> · päivitetty ${pvm}`;
      if (holo && h.variantti !== 'holo') teksti += '<br>Holo-hintaa ei löytynyt, käytetty normaalia hintaa.';
      if (result.ehdotukset?.length) {
        const muut = result.ehdotukset.map((e: any) => escapeHtml(e.setti || e.id)).join(', ');
        teksti += `<br>Muita samannumeroisia: ${muut} — tarkista että setti on oikea.`;
      }
      nayta('ok', teksti);
    } catch (err) {
      nayta('miss', 'Haku epäonnistui: ' + escapeHtml((err as Error).message));
    } finally {
      btn.disabled = false;
      btn.textContent = 'Hae hinta-arvio';
    }
  });

  $<HTMLFormElement>('addForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const errEl = $('formError');
    errEl.style.display = 'none';
    const submitBtn = $<HTMLButtonElement>('submitBtn');
    submitBtn.disabled = true;
    const payload = {
      nimi: $<HTMLInputElement>('f_nimi').value.trim(),
      numero: $<HTMLInputElement>('f_numero').value.trim(),
      kategoria: $<HTMLSelectElement>('f_kategoria').value,
      kunto: $<HTMLSelectElement>('f_kunto').value,
      arvo: parseFloat($<HTMLInputElement>('f_arvo').value) || 0,
      kuva: hakuKuva,
    };
    try {
      let created = await adminRequest<Card>(API, { method: 'POST', body: JSON.stringify(payload) });
      const tiedosto = $<HTMLInputElement>('f_kuva').files?.[0];
      if (tiedosto) {
        const data = new FormData();
        data.append('kuva', tiedosto);
        try {
          created = (await adminRequest<{ kortti: Card }>(`${API}/${created._id}/kuva`, { method: 'POST', body: data })).kortti;
        } catch (err) {
          alert('Kortti lisättiin, mutta kuvan lataus epäonnistui: ' + (err as Error).message + '\nVoit lisätä kuvan taulukosta.');
        }
      }
      allCards.push(created);
      form.reset();
      naytaEsikatselu();
      modal.close();
      renderAll();
    } catch (err) {
      errEl.textContent = (err as Error).message;
      errEl.style.display = 'block';
    } finally {
      submitBtn.disabled = false;
    }
  });

  async function loadTarjoukset() {
    try {
      const tarjoukset = await adminRequest<Tarjous[]>('/api/tarjoukset?tila=odottaa');
      const panel = $('tarjousPanel');
      const list = $('tarjousList');
      $('tarjousCount').textContent = String(tarjoukset.length);

      if (!tarjoukset.length) {
        panel.style.display = 'none';
        return;
      }
      panel.style.display = 'block';
      list.innerHTML = tarjoukset.map((t) => `
        <div class="tarjous">
          <div>
            <div class="nimi">${escapeHtml(t.kortti_id?.nimi || '(kortti poistettu)')} ${escapeHtml(t.kortti_id?.numero || '')}</div>
            <div class="meta">
              ${escapeHtml(t.ostajan_nimi)} — ${escapeHtml(t.ostajan_sahkoposti)} —
              tarjous <b>${eur(t.tarjottu_hinta)}</b>
              ${t.kortti_id ? ` (oma arvio ${eur(t.kortti_id.arvo)})` : ''}
            </div>
            ${t.ostajan_viesti ? `<div class="viesti">"${escapeHtml(t.ostajan_viesti)}"</div>` : ''}
          </div>
          <div class="actions">
            <button class="icon-btn accept" data-action="hyvaksy" data-id="${t._id}">Hyväksy</button>
            <button class="icon-btn reject" data-action="hylkaa" data-id="${t._id}">Hylkää</button>
          </div>
        </div>`).join('');

      list.querySelectorAll<HTMLButtonElement>('button[data-action]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          try {
            await adminRequest(`/api/tarjoukset/${btn.dataset.id}`, { method: 'PATCH', body: JSON.stringify({ paatos: btn.dataset.action }) });
            await loadTarjoukset();
            await loadCards();
          } catch (err) {
            alert('Tarjouksen käsittely epäonnistui: ' + (err as Error).message);
            btn.disabled = false;
          }
        });
      });
    } catch (err) {
      console.error('Tarjousten lataus epäonnistui:', (err as Error).message);
    }
  }

  loadCards();
  loadTarjoukset();
</script>
